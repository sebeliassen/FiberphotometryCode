# ------------------------------------------------------------------------------
*.h5
*.hdf5
*.pkl
*.pickle
*.p
*.joblib
*.pt
*.pth
*.onnx
*.npy
*.npz
*.parquet
*.feather
*.db
*.sqlite
*.sqlite3

