# ------------------------------------------------------------------------------
# 7. Tabular Data: Exclude data CSVs/TSVs by default, allow small configs/manifests
# ------------------------------------------------------------------------------
*.csv
*.tsv

# Unignore small configuration/manifest CSVs and TSVs
!**/overrides/*.csv
!**/overrides/*.tsv
!**/configs/*.csv
!**/configs/*.tsv
!**/*manifest*.csv
!**/*manifest*.tsv
!**/*mapping*.csv
!**/*mapping*.tsv
!ARTIFACT_INVENTORY.tsv
!PERMISSIONS_MODIFIED_TIER_A.tsv
!DUPLICATES.tsv
!registry.tsv
!MOVES.tsv
!registry/*.tsv
!registry/*.sh

# ------------------------------------------------------------------------------
# 8. Large Generated / Concatenated Text Bundles
# ------------------------------------------------------------------------------
*concat*.txt
*concat*.tsv
*review_package*.txt
fiberphotometry_code_review.zip*
SWE_ORGANIZATION_BOT_PROMPT.md

# ------------------------------------------------------------------------------
# 9. Whitelist Essential Repository Code, Configs, Documentation
# ------------------------------------------------------------------------------
!.gitignore
!.gitignore.legacy
!LICENSE
!README.md
!pyproject.toml
# Small regression data and the explicit, manual runtime check are repository inputs.
!tests/golden/historical_session_slice.npz
!/ops/diagnostics/
/ops/diagnostics/*
!/ops/diagnostics/smoke_runtime.py
!/ops/diagnostics/serve_local_viewer.py
!/ops/diagnostics/validate_two_sessions.py
!/ops/diagnostics/.folder-map.md
# Accepted, small rollback/validation manifests are source-controlled.
!registry/checkpoints/
!registry/checkpoints/**

# Python source packages whose names overlap empirical data/model exclusions.
# Keep payloads ignored; expose only Python source and generated navigation.
!studies/photometry_exploration/data/
studies/photometry_exploration/data/*
!studies/photometry_exploration/data/*.py
!studies/photometry_exploration/data/.folder-map.md
!studies/language_models/lib/data/
studies/language_models/lib/data/*
!studies/language_models/lib/data/*.py
!studies/language_models/lib/data/.folder-map.md
!studies/language_models/lib/models/
studies/language_models/lib/models/*
!studies/language_models/lib/models/*.py
!studies/language_models/lib/models/.folder-map.md
